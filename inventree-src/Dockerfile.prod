# Production image for the Nexa Inventory deployment.
# Adapted from contrib/container/Dockerfile — adds the nexa_inventory plugin
# into the image build so it's baked into the InvenTree production target
# instead of relying on plugins.txt / pip-at-runtime install.
#
# Build context MUST be this directory (inventree-src/).

FROM python:3.14.7-slim-trixie@sha256:cad9a2c871761c413caa6fdd6441c783451e740a48aaeba60ae62a8b53525ef6 AS inventree_base

ARG commit_tag=""
ARG commit_hash=""
ARG commit_date=""

ARG data_dir="data"
ARG NODE_VERSION=24

ENV PYTHONUNBUFFERED=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV INVOKE_RUN_SHELL="/bin/bash"

ENV INVENTREE_DOCKER="true"

ENV INVENTREE_HOME="/home/inventree"
ENV INVENTREE_DATA_DIR="${INVENTREE_HOME}/${data_dir}"
ENV INVENTREE_STATIC_ROOT="${INVENTREE_DATA_DIR}/static"
ENV INVENTREE_MEDIA_ROOT="${INVENTREE_DATA_DIR}/media"
ENV INVENTREE_BACKUP_DIR="${INVENTREE_DATA_DIR}/backup"
ENV INVENTREE_PLUGIN_DIR="${INVENTREE_DATA_DIR}/plugins"

ENV INVENTREE_BACKEND_DIR="${INVENTREE_HOME}/src/backend"

ENV INVENTREE_CONFIG_FILE="${INVENTREE_DATA_DIR}/config.yaml"
ENV INVENTREE_SECRET_KEY_FILE="${INVENTREE_DATA_DIR}/secret_key.txt"
ENV INVENTREE_OIDC_PRIVATE_KEY_FILE="${INVENTREE_DATA_DIR}/oidc.pem"
ENV INVENTREE_PLUGIN_FILE="${INVENTREE_DATA_DIR}/plugins.txt"

ENV INVENTREE_GUNICORN_WORKERS="4"
ENV INVENTREE_BACKGROUND_WORKERS="4"

ENV INVENTREE_WEB_ADDR=0.0.0.0
ENV INVENTREE_WEB_PORT=8000

RUN apt-get update && apt-get install -y --no-install-recommends \
    git gettext libldap2 wget curl ssh \
    weasyprint libpango-1.0-0 libcairo2 poppler-utils \
    postgresql-client mariadb-client \
    fontconfig fonts-freefont-ttf fonts-terminus fonts-noto-core fonts-noto-cjk \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN rm -rf /usr/lib/python3/dist-packages/numpy \
    && rm -rf /usr/lib/python3/dist-packages/scipy \
    && rm -rf /usr/lib/python3/dist-packages/sympy

EXPOSE 8000

RUN python -m pip install --no-cache-dir -U invoke

RUN mkdir -p ${INVENTREE_HOME}
WORKDIR ${INVENTREE_HOME}

COPY contrib/container/requirements.txt base_requirements.txt

COPY tasks.py \
     src/backend/requirements.txt \
     contrib/container/gunicorn.conf.py \
     contrib/container/init.sh \
     ./
RUN chmod +x init.sh

ENTRYPOINT ["/bin/bash", "./init.sh"]

# ---- Build stage: compile backend deps, frontend, and our plugin ----
FROM inventree_base AS builder_stage

COPY src ${INVENTREE_HOME}/src
COPY tasks.py ${INVENTREE_HOME}/tasks.py
COPY nexa_inventory_plugin ${INVENTREE_HOME}/nexa_inventory_plugin

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config build-essential \
    libldap2-dev libsasl2-dev libssl-dev \
    libmariadb-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --user --require-hashes -r base_requirements.txt --no-cache-dir && \
    pip install --user --require-hashes -r requirements.txt --no-cache-dir && \
    pip cache purge && \
    rm -rf /root/.cache/pip

# Install the nexa_inventory plugin (registers via its inventree_plugins entry point)
RUN pip install --user --no-cache-dir ./nexa_inventory_plugin

RUN curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/1889911f0841e669de0be5bd02c737a3f1fd20fa/install.sh | bash && \
    bash -c "export NVM_DIR="$HOME/.nvm" && source $HOME/.nvm/nvm.sh && \
    nvm install $NODE_VERSION && corepack enable yarn && yarn config set network-timeout 600000 -g"
RUN bash -c "source $HOME/.nvm/nvm.sh && cd '${INVENTREE_HOME}' && invoke int.frontend-compile"

# ---- Production stage ----
FROM inventree_base AS production

ENV INVENTREE_DEBUG=False

ENV INVENTREE_COMMIT_HASH="${commit_hash}"
ENV INVENTREE_COMMIT_DATE="${commit_date}"

COPY src/backend/InvenTree ${INVENTREE_BACKEND_DIR}/InvenTree
COPY src/backend/requirements.txt ${INVENTREE_BACKEND_DIR}/requirements.txt

# gitignored upstream (local-plugin-dev scaffold dir) — must exist as an importable package
RUN mkdir -p ${INVENTREE_BACKEND_DIR}/InvenTree/plugins && \
    printf '"""Directory for custom plugin development."""\n' > ${INVENTREE_BACKEND_DIR}/InvenTree/plugins/__init__.py

ENV PATH=/root/.local/bin:$PATH

COPY --from=builder_stage ${INVENTREE_BACKEND_DIR}/InvenTree/web/static/web ${INVENTREE_BACKEND_DIR}/InvenTree/web/static/web
COPY --from=builder_stage /root/.local /root/.local

RUN bash -c "cd '${INVENTREE_HOME}' && invoke int.backend-compilemessages"

RUN pip-licenses --format=json --with-license-file --no-license-path > "${INVENTREE_BACKEND_DIR}/InvenTree/InvenTree/licenses.txt" \
    && test -s "${INVENTREE_BACKEND_DIR}/InvenTree/InvenTree/licenses.txt"

CMD ["sh", "-c", "cd ${INVENTREE_BACKEND_DIR}/InvenTree && python3 manage.py collectstatic --no-input --verbosity 0 && cd ${INVENTREE_HOME} && exec gunicorn -c ./gunicorn.conf.py InvenTree.wsgi -b ${INVENTREE_WEB_ADDR}:${INVENTREE_WEB_PORT} --chdir ${INVENTREE_BACKEND_DIR}/InvenTree"]
