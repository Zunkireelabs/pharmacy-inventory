# Runtime env vars for the production container — copy to .env.local on the VPS
# (docker-compose.prod.yml directory) and fill in real values. Never commit .env.local.

INVENTREE_SITE_URL=https://nexa-inventory.zunkireelabs.com
INVENTREE_DEBUG=False
INVENTREE_LOG_LEVEL=WARNING
INVENTREE_PLUGINS_ENABLED=True
INVENTREE_AUTO_UPDATE=True

INVENTREE_USE_X_FORWARDED_HOST=True
INVENTREE_USE_X_FORWARDED_PORT=True
INVENTREE_USE_X_FORWARDED_PROTO=True

# Supabase-hosted Postgres (Project Settings > Database)
INVENTREE_DB_ENGINE=postgresql
INVENTREE_DB_NAME=postgres
INVENTREE_DB_HOST=<SUPABASE_POOLER_HOST>
INVENTREE_DB_PORT=5432
INVENTREE_DB_USER=postgres.<SUPABASE_REF>
INVENTREE_DB_PASSWORD=
INVENTREE_DB_OPTIONS={"sslmode": "require"}

# Redis cache: enabled by docker-compose.prod.yml (service nexa-cache), which
# overrides this value. Keep False for a plain local run without redis.
INVENTREE_CACHE_ENABLED=False

# Seconds a database connection is kept open and reused between requests
INVENTREE_DB_CONN_MAX_AGE=600

INVENTREE_GUNICORN_TIMEOUT=90
